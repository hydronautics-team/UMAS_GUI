   <string notr="true">
/* === ГЛОБАЛЬНАЯ ТЕМНАЯ ТЕМА С СИНИМИ АКЦЕНТАМИ === */
QMainWindow, QWidget#centralwidget {
    background-color: #0d1b2a;
    color: #e0e6ed;
    font-family: 'Segoe UI', 'Roboto', sans-serif;
    font-size: 13px;
}

/* === КНОПКИ === */
QPushButton {
    background-color: #1e2a38;
    border: 1px solid #2d4052;
    border-radius: 4px;
    padding: 5px 12px;
    color: #e0e6ed;
    min-height: 20px;
    font-size: 12px;
}
QPushButton:hover {
    background-color: #2d4052;
    border: 1px solid #00bcd4;
    color: #ffffff;
}
QPushButton:pressed {
    background-color: #00bcd4;
    color: #0f1419;
    font-weight: bold;
}
QPushButton:disabled {
    background-color: #151b23;
    color: #4a5568;
    border: 1px solid #1e2a38;
}
QPushButton:checked {
    background-color: #00bcd4;
    color: #0f1419;
    font-weight: bold;
}

/* Специальный стиль для кнопок режимов скорости - ЗЕЛЕНЫЙ при выборе */
QPushButton#pushButton_speedFast:checked,
QPushButton#pushButton_speedMedium:checked,
QPushButton#pushButton_speedSlow:checked {
    background-color: #00ff88;
    color: #0f1419;
    border: 1px solid #00ff88;
    font-weight: bold;
    font-size: 13px;
}
QPushButton#pushButton_speedFast:hover,
QPushButton#pushButton_speedMedium:hover,
QPushButton#pushButton_speedSlow:hover {
    border: 1px solid #00ff88;
}

/* Специальный стиль для кнопок режимов управления */
QPushButton#pushButton_modeManual:checked,
QPushButton#pushButton_modeAutomated:checked,
QPushButton#pushButton_modeAutomatic:checked {
    background-color: #00bcd4;
    color: #0f1419;
    font-weight: bold;
}

/* Специальный стиль для кнопок каналов автоматизации */
QPushButton#pushButton_modeAutomated_surge:checked,
QPushButton#pushButton_modeAutomated_sway:checked,
QPushButton#pushButton_modeAutomated_depth:checked,
QPushButton#pushButton_modeAutomated_yaw:checked,
QPushButton#pushButton_modeAutomated_pitch:checked,
QPushButton#pushButton_modeAutomated_roll:checked {
    background-color: #00bcd4;
    color: #0f1419;
    font-weight: bold;
}

/* === ВКЛАДКИ === */
QTabWidget::pane {
    border: 1px solid #2d4052;
    background-color: #151b23;
    border-radius: 4px;
}
QTabBar::tab {
    background-color: #1e2a38;
    color: #8a99a8;
    padding: 6px 14px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    margin-right: 2px;
    border: 1px solid #2d4052;
    border-bottom: none;
    font-size: 12px;
}
QTabBar::tab:selected {
    background-color: #00bcd4;
    color: #0f1419;
    font-weight: bold;
}
QTabBar::tab:hover:!selected {
    background-color: #2d4052;
    color: #ffffff;
}

/* === ПОЛЯ ВВОДА === */
QLineEdit, QSpinBox, QComboBox, QDoubleSpinBox {
    background-color: #151b23;
    border: 1px solid #2d4052;
    border-radius: 3px;
    padding: 3px 6px;
    color: #e0e6ed;
    selection-background-color: #00bcd4;
    selection-color: #0f1419;
    font-size: 12px;
}
QLineEdit:focus, QSpinBox:focus, QComboBox:focus, QDoubleSpinBox:focus {
    border: 1px solid #00bcd4;
}
QComboBox::drop-down {
    border: none;
    width: 18px;
}
QComboBox QAbstractItemView {
    background-color: #151b23;
    border: 1px solid #2d4052;
    color: #e0e6ed;
    selection-background-color: #00bcd4;
    selection-color: #0f1419;
}

/* === ГРУППОВЫЕ БЛОКИ === */
QGroupBox {
    border: 1px solid #2d4052;
    border-radius: 5px;
    margin-top: 10px;
    font-weight: bold;
    color: #00bcd4;
    background-color: #151b23;
    padding-top: 14px;
    font-size: 12px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 5px;
    color: #00bcd4;
}

/* === РАДИОКНОПКИ И ЧЕКБОКСЫ === */
QRadioButton, QCheckBox {
    color: #e0e6ed;
    spacing: 5px;
    font-size: 12px;
}
QRadioButton::indicator, QCheckBox::indicator {
    width: 14px;
    height: 14px;
}

/* === ТЕКСТОВЫЕ ОБЛАСТИ === */
QTextEdit {
    background-color: #0a0e13;
    color: #4ade80;
    border: 1px solid #2d4052;
    border-radius: 3px;
    padding: 3px;
    font-family: 'Consolas', 'Courier New', monospace;
    font-size: 11px;
}

/* === LCD ДИСПЛЕИ (компактные) === */
QLCDNumber {
    background-color: #0a0e13;
    color: #00ff88;
    border: 1px solid #2d4052;
    border-radius: 3px;
    padding: 1px 2px;
    font-size: 14px;
    min-height: 28px;
    max-height: 32px;
}

/* === РАЗДЕЛИТЕЛИ === */
Line {
    color: #2d4052;
    max-height: 1px;
}

/* === МЕТКИ === */
QLabel {
    color: #e0e6ed;
    background: transparent;
    font-size: 12px;
}

/* === ФРЕЙМЫ === */
QFrame[frameShape="4"], QFrame[frameShape="5"] {
    color: #2d4052;
    max-height: 1px;
}

/* === СКРОЛЛБАРЫ === */
QScrollBar:vertical {
    background-color: #0d1b2a;
    width: 10px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background-color: #2d4052;
    min-height: 20px;
    border-radius: 5px;
}
QScrollBar::handle:vertical:hover {
    background-color: #00bcd4;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}
QScrollBar:horizontal {
    background-color: #0d1b2a;
    height: 10px;
}
QScrollBar::handle:horizontal {
    background-color: #2d4052;
    min-width: 20px;
    border-radius: 5px;
}
QScrollBar::handle:horizontal:hover {
    background-color: #00bcd4;
}

/* === МЕНЮБАР И СТАТУСБАР === */
QMenuBar {
    background-color: #0d1b2a;
    color: #e0e6ed;
    border-bottom: 1px solid #2d4052;
}
QMenuBar::item:selected {
    background-color: #00bcd4;
    color: #0f1419;
}
QMenu {
    background-color: #151b23;
    border: 1px solid #2d4052;
    color: #e0e6ed;
}
QMenu::item:selected {
    background-color: #00bcd4;
    color: #0f1419;
}
QStatusBar {
    background-color: #0d1b2a;
    color: #8a99a8;
    border-top: 1px solid #2d4052;
}

/* === ТУЛТИПЫ === */
QToolTip {
    background-color: #1e2a38;
    color: #e0e6ed;
    border: 1px solid #00bcd4;
    padding: 3px;
    border-radius: 3px;
}
